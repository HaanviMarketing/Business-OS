{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and tenant access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "organizationId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role", "organizationId"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant company workspace with business settings and live metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "tier": { "type": "string" },
        "currency": { "type": "string" },
        "cashBalance": { "type": "number" },
        "burnRate": { "type": "number" },
        "mrr": { "type": "number" },
        "arr": { "type": "number" },
        "runwayMonths": { "type": "number" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger record of income or expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "orgId", "description", "amount", "type"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales invoice for customer billing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "dueDate": { "type": "string" },
        "issuedDate": { "type": "string" }
      },
      "required": ["id", "orgId", "invoiceNumber", "clientName", "amount", "status"]
    },
    "CrmLead": {
      "title": "CrmLead",
      "description": "Sales deal and CRM contact record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "company": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "dealValue": { "type": "number" },
        "stage": { "type": "string" },
        "health": { "type": "string" },
        "lastContact": { "type": "string" }
      },
      "required": ["id", "orgId", "company", "dealValue", "stage"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Product inventory and stock level",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "quantity": { "type": "number" },
        "unitCost": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "reorderPoint": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "orgId", "name", "sku", "quantity", "unitCost", "sellingPrice"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Real-time collaborative audit event across team members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "detail": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "orgId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and credentials"
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Multi-tenant company profiles"
    },
    "/organizations/{orgId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Organization financial records"
    },
    "/organizations/{orgId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Organization sales invoices"
    },
    "/organizations/{orgId}/crm_leads/{leadId}": {
      "schema": "CrmLead",
      "description": "Organization CRM sales leads"
    },
    "/organizations/{orgId}/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Organization inventory items"
    },
    "/organizations/{orgId}/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Organization live real-time activity stream"
    }
  }
}
